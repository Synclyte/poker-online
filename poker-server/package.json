{
  "name": "poker-server",
  "version": "1.0.0",
  "description": "Poker Server",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build:engine": "cd ../poker-engine && wasm-pack build --target nodejs --out-dir ../poker-server/pkg",
    "build:client": "cd ../poker-client && npm install && npm run build && node -e \"import fs from 'fs'; fs.cpSync('../poker-client/dist', './public', { recursive: true });\"",
    "build": "npm run build:engine && npm run build:client && tsc",
    "dev": "tsx watch server.ts",
    "start": "node dist/server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
